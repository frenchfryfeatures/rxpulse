# local | test | staging | production
ENV=local
DATABASE_URL=postgresql+asyncpg://rxpulse:rxpulse@localhost:5432/rxpulse
CORS_ORIGINS=["http://localhost:3000"]

# entra = Microsoft Entra ID tokens from MSAL (default); dev = local sign-in picker (never in staging/production)
AUTH_MODE=dev
# Required when AUTH_MODE=entra
AZURE_TENANT_ID=
AZURE_API_CLIENT_ID=
# JSON list; defaults to [AZURE_TENANT_ID]
# ALLOWED_TENANTS=["<tenant-guid>"]

PHARMACY_LOCATION_CODE=MAIN-PHARMACY
MIN_SHELF_LIFE_DAYS=30
